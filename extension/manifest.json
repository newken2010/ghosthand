{
  "manifest_version": 3,
  "name": "GhostHand - 拟人浏览器自动化",
  "version": "0.1.0",
  "description": "不规则节奏 / 长按拖动 / 反检测的拟人浏览器自动化。AI 网关客户端 + 纯插件 trusted 输入模式。",
  "permissions": [
    "debugger",
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GhostHand",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["stealth.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}